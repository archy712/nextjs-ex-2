# 아래 값은 모두 서버 전용입니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요 — 붙이면 클라이언트 번들에 노출됩니다.

# NOTION_API_KEY: Notion 통합(Integration) 생성 후 발급되는 토큰
NOTION_API_KEY=

# NOTION_ITEMS_DATA_SOURCE_ID: Items 데이터베이스의 데이터소스 ID(데이터베이스 ID 아님)
NOTION_ITEMS_DATA_SOURCE_ID=

# NOTION_INVOICES_DATA_SOURCE_ID: Invoices 데이터베이스의 데이터소스 ID(데이터베이스 ID 아님)
NOTION_INVOICES_DATA_SOURCE_ID=

# ADMIN_PASSWORD: 관리자 로그인 비밀번호(8자 이상, 직접 정하세요)
ADMIN_PASSWORD=

# ADMIN_SESSION_SECRET: `openssl rand -base64 32`로 생성
ADMIN_SESSION_SECRET=
